{
  "name": "sanlam-web-framework",
  "version": "1.0.0",
  "description": "Sanlam Online link integrity + header reachability framework \u2014 Playwright + TypeScript, self-healing locators, CI/CD to AWS",
  "scripts": {
    "test": "playwright test",
    "test:links": "playwright test tests/link-integrity.spec.ts",
    "test:nav": "playwright test tests/nav-reachability.spec.ts",
    "test:mobile": "playwright test tests/mobile-menu.spec.ts --project=mobile",
    "test:headed": "playwright test --headed --project=chromium",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report",
    "baseline:update": "UPDATE_BASELINE=1 playwright test tests/link-integrity.spec.ts --project=chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^26.5.0",
    "typescript": "^5.5.0"
  }
}
